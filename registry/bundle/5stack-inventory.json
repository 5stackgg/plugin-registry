{
  "$schema": "../../schema/plugin.schema.json",
  "slug": "5stack-inventory",
  "kind": "bundle",
  "name": "5Stack Inventory",
  "author": "lukepolo",
  "description": "A loadout editor that renders natively inside the panel, plus the game-server plugin that puts those loadouts in players' hands. Installs both halves and wires them together.",
  "homepage": "https://github.com/lukepolo/5stack-inventory-plugin",
  "tags": ["cosmetics", "skins", "fun", "panel"],
  "verified": true,
  "hot_swappable": false,
  "panel": {
    "manifest_url": "https://github.com/lukepolo/5stack-inventory-plugin",
    "repo": "lukepolo/5stack-inventory-plugin",
    "install_command": "./plugin.sh lukepolo/5stack-inventory-plugin"
  },
  "variants": {
    "swiftlys2": {
      "repo": "ianlucas/cs2-ss2-inventory-simulator",
      "asset": "InventorySimulator-v*.zip",
      "layout": "csgo"
    },
    "counterstrikesharp": {
      "repo": "ianlucas/cs2-css-inventory-simulator",
      "asset": "InventorySimulator-v*.zip",
      "layout": "csgo"
    }
  },
  "wiring": {
    "provision": {
      "from": "panel",
      "endpoint": "/api/admin/server-api-key",
      "method": "POST",
      "response_key": "key"
    },
    "config": {
      "invsim_url": "{panel.base_url}",
      "invsim_apikey": "{provision.key}",
      "invsim_ws_enabled": "1",
      "invsim_ws_immediately": "1",
      "invsim_require_inventory": "1",
      "invsim_spraychanger_enabled": "1"
    },
    "target": "mode_cfg"
  }
}
