{
  "$schema": "../../schema/plugin.schema.json",
  "slug": "5stack-inventory",
  "kind": "panel",
  "name": "5Stack Inventory",
  "author": "lukepolo",
  "description": "A loadout editor that renders natively inside the panel. Pairs with the CS2 Inventory Simulator game plugin, which puts those loadouts in players' hands.",
  "homepage": "https://github.com/lukepolo/5stack-inventory-plugin",
  "tags": [
    "cosmetics",
    "skins",
    "fun",
    "panel"
  ],
  "verified": true,
  "hot_swappable": false,
  "panel": {
    "slug": "inventory",
    "manifest_url": "https://github.com/lukepolo/5stack-inventory-plugin",
    "repo": "lukepolo/5stack-inventory-plugin",
    "install_command": "./plugin.sh lukepolo/5stack-inventory-plugin"
  },
  "pairs_with": [
    "inventory-simulator"
  ],
  "wiring": {
    "provision": {
      "from": "panel",
      "endpoint": "/api/admin/server-api-key",
      "method": "POST",
      "response_key": "key"
    },
    "config": {
      "invsim_url": "{panel.base_url}",
      "invsim_apikey": "{provision.key}",
      "invsim_ws_enabled": "1",
      "invsim_ws_immediately": "1",
      "invsim_require_inventory": "1",
      "invsim_spraychanger_enabled": "1"
    },
    "target": "mode_cfg"
  }
}
