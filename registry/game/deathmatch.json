{
  "$schema": "../../schema/plugin.schema.json",
  "slug": "deathmatch",
  "kind": "game",
  "name": "Deathmatch",
  "author": "ianlucas",
  "description": "Free-for-all deathmatch with random spawns, timed weapon-mode rotation (pistols, mid-tier, rifles), health and armor back on kills, gun commands and bot loadouts.",
  "homepage": "https://github.com/ianlucas/cs2-ss2-deathmatch",
  "tags": ["gamemode", "deathmatch", "ffa", "warmup"],
  "verified": true,
  "hot_swappable": false,
  "cvars": [
    "dm_chat_prefix",
    "dm_modes_file",
    "dm_pro_ratio",
    "dm_replenish_health",
    "dm_replenish_health_headshot",
    "dm_replenish_armor",
    "dm_replenish_armor_headshot"
  ],
  "config_path": "addons/swiftlys2/configs/plugins/Deathmatch/modes.json",
  "config_cvar": "dm_modes_file",
  "config_schema": {
    "type": "array",
    "title": "Weapon rotation",
    "description": "Each mode runs for its duration, then the next one starts. Players can only pick the weapons their mode allows.",
    "items": {
      "type": "object",
      "title": "Mode",
      "required": ["name", "weapons", "duration"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name"
        },
        "duration": {
          "type": "integer",
          "title": "Duration (seconds)",
          "minimum": 1
        },
        "helmet": {
          "type": "boolean",
          "title": "Helmet",
          "default": true
        },
        "weapons": {
          "type": "array",
          "title": "Allowed weapons",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "deagle",
              "elite",
              "fiveseven",
              "glock",
              "tec9",
              "hkp2000",
              "p250",
              "usp_silencer",
              "cz75a",
              "revolver",
              "mac10",
              "mp5sd",
              "mp7",
              "mp9",
              "ump45",
              "p90",
              "bizon",
              "mag7",
              "nova",
              "sawedoff",
              "xm1014",
              "m249",
              "negev",
              "ak47",
              "m4a1",
              "m4a1_silencer",
              "aug",
              "sg556",
              "famas",
              "galilar",
              "awp",
              "ssg08",
              "scar20",
              "g3sg1"
            ]
          }
        },
        "bots": {
          "type": "object",
          "title": "Bot loadout",
          "required": ["secondary"],
          "properties": {
            "secondary": {
              "type": "array",
              "title": "Secondary",
              "items": {
                "type": "object",
                "required": ["weapon", "probability"],
                "properties": {
                  "weapon": {
                    "type": "string",
                    "title": "Weapon",
                    "enum": [
                      "deagle",
                      "elite",
                      "fiveseven",
                      "glock",
                      "tec9",
                      "hkp2000",
                      "p250",
                      "usp_silencer",
                      "cz75a",
                      "revolver",
                      "mac10",
                      "mp5sd",
                      "mp7",
                      "mp9",
                      "ump45",
                      "p90",
                      "bizon",
                      "mag7",
                      "nova",
                      "sawedoff",
                      "xm1014",
                      "m249",
                      "negev",
                      "ak47",
                      "m4a1",
                      "m4a1_silencer",
                      "aug",
                      "sg556",
                      "famas",
                      "galilar",
                      "awp",
                      "ssg08",
                      "scar20",
                      "g3sg1"
                    ]
                  },
                  "probability": {
                    "type": "number",
                    "title": "Chance",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "primary": {
              "type": "array",
              "title": "Primary",
              "items": {
                "type": "object",
                "required": ["weapon", "probability"],
                "properties": {
                  "weapon": {
                    "type": "string",
                    "title": "Weapon",
                    "enum": [
                      "deagle",
                      "elite",
                      "fiveseven",
                      "glock",
                      "tec9",
                      "hkp2000",
                      "p250",
                      "usp_silencer",
                      "cz75a",
                      "revolver",
                      "mac10",
                      "mp5sd",
                      "mp7",
                      "mp9",
                      "ump45",
                      "p90",
                      "bizon",
                      "mag7",
                      "nova",
                      "sawedoff",
                      "xm1014",
                      "m249",
                      "negev",
                      "ak47",
                      "m4a1",
                      "m4a1_silencer",
                      "aug",
                      "sg556",
                      "famas",
                      "galilar",
                      "awp",
                      "ssg08",
                      "scar20",
                      "g3sg1"
                    ]
                  },
                  "probability": {
                    "type": "number",
                    "title": "Chance",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "config_shipped": {
